# Optional Playwright a11y smoke (tests skip when unset).
# Copy credentials from your Docker Nextcloud admin / planner user.

NC_BASE_URL=http://localhost:8081

# Prefer an app admin / planner who can open DutyCheck settings + roster:
# NC_ADMIN_USER=admin
# NC_ADMIN_PASS=

# Or a linked employee (dashboard / my-roster surfaces only):
# NC_EMPLOYEE_USER=
# NC_EMPLOYEE_PASS=
#
# Nextcloud password policy rejects weak fixtures. After host/Docker resets,
# re-sync NC_EMPLOYEE_PASS with:
#   npm run e2e:sync-employee
#   # or: bash tests/e2e/scripts/sync-employee-fixture.sh
# Use a strong value (e.g. DcAtlasR5_Employee!) and keep it only in gitignored .env.
# Employee a11y runs this sync automatically in beforeAll.
